# Authority Runtime - Environment Variables
#
# Copy to .env and configure as needed.

# --- Carryall Server ---

# Bearer token for HTTP API authentication.
# Leave empty for no auth (development only).
CARRYALL_API_KEY=

# Log level: DEBUG, INFO, WARNING, ERROR
CARRYALL_LOG_LEVEL=INFO

# Log format: json (structured) or text (human-readable)
CARRYALL_LOG_FORMAT=json

# Rate limit: max requests per minute per IP
CARRYALL_RATE_LIMIT=100

# --- LLM Providers (for policy compiler) ---

# OpenAI API key (required for LLM policy compiler)
OPENAI_API_KEY=

# Anthropic API key (optional, alternative compiler)
ANTHROPIC_API_KEY=

# --- SLOS Backend ---

# Path to SLOS integration config (JSON).
# If unset, uses MemoryBackend (no persistent vaults).
CARRYALL_SLOS_CONFIG=
