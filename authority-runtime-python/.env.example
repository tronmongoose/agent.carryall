# Authority Runtime - Environment Variables

# OpenAI API key (required - for LLM policy compiler)
OPENAI_API_KEY=sk-your-openai-api-key-here

# Anthropic API key (optional - for Claude-based policy compilation)
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here

# Tavily API key (optional - for research agent web search)
# Get a free key at https://tavily.com
TAVILY_API_KEY=tvly-your-tavily-api-key-here
