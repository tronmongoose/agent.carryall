# Clawdbot Gateway - AI Agent Orchestrator with Carryall MCP Server
# Runs the Clawdbot gateway with carryall as an MCP server for policy enforcement

FROM node:22-slim

# Install dependencies: git for npm, python for carryall
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    git \
    python3 \
    python3-pip \
    python3-venv \
    && rm -rf /var/lib/apt/lists/*

# Install clawdbot globally
ARG CLAWDBOT_VERSION=2026.1.24-3
RUN npm install -g clawdbot@${CLAWDBOT_VERSION}

# Security: create non-root user
RUN groupadd -r clawdbot && useradd -r -g clawdbot -d /home/clawdbot -m clawdbot

# Create required directories
RUN mkdir -p /home/clawdbot/.clawdbot/agents/main/agent \
             /home/clawdbot/.clawdbot/credentials \
             /home/clawdbot/.carryall/keys \
             /home/clawdbot/.carryall/credentials \
             /home/clawdbot/workspace \
    && chown -R clawdbot:clawdbot /home/clawdbot

# Install carryall plugin (native agent tools + skill docs)
COPY extensions/carryall/ /home/clawdbot/.clawdbot/extensions/carryall/

# Install carryall (authority-runtime) in a venv
COPY authority-runtime-python/ /tmp/authority-runtime-python/
RUN python3 -m venv /opt/carryall \
    && /opt/carryall/bin/pip install --no-cache-dir /tmp/authority-runtime-python/ \
    && rm -rf /tmp/authority-runtime-python/

# Add carryall to PATH
ENV PATH="/opt/carryall/bin:$PATH"

# Set environment
ENV HOME="/home/clawdbot"
ENV NODE_ENV="production"

# Switch to non-root user
USER clawdbot
WORKDIR /home/clawdbot

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=3 \
    CMD node -e "require('net').connect(18789, '127.0.0.1').on('connect', () => process.exit(0)).on('error', () => process.exit(1))" || exit 1

# Default command: run gateway
CMD ["clawdbot", "gateway"]

# Expose gateway port
EXPOSE 18789

# Labels
LABEL org.opencontainers.image.source="https://github.com/tronmongoose/agent.carryall"
LABEL org.opencontainers.image.description="Clawdbot gateway with Carryall MCP policy enforcement"
LABEL org.opencontainers.image.licenses="MIT"
